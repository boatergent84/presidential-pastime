export default function PresidentialSignaturesPage() {
  const [search, setSearch] = useState("");
  const filtered = useMemo(
    () => artifacts.filter(a =>
      `${a.president} ${a.years} ${a.note}`.toLowerCase().includes(search.toLowerCase())
    ),
    [search]
  );

  return (
    <main className="min-h-screen bg-[#eee7d7] text-[#102c44]">
      <header className="border-b-4 border-[#a4282d] bg-[#102c44] px-6 py-5 text-white">
        <div className="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-4">
          <Link href="/" className="font-serif text-2xl font-bold">PRESIDENTIAL PASTIME</Link>
          <Link href="/heritage-collection" className="text-sm text-[#d7bb83]">← Heritage Collection</Link>
        </div>
      </header>

      <section className="border-b border-[#b89a61] bg-[#102c44] px-6 py-20 text-center text-white">
        <p className="text-xs font-bold uppercase tracking-[0.3em] text-[#d7bb83]">
          The Heritage Collection · Special Museum Exhibit
        </p>
        <div className="mx-auto my-8 flex h-28 w-28 items-center justify-center rounded-full border-4 border-[#b89a61] bg-[#eee7d7] text-6xl shadow-xl">
          ⚾
        </div>
        <h1 className="font-serif text-4xl font-bold md:text-6xl">
          The Presidential Signature Collection
        </h1>
        <p className="mx-auto mt-5 max-w-2xl font-serif text-xl italic text-[#d7bb83]">
          A History of America, Written on Baseballs
        </p>
        <p className="mx-auto mt-7 max-w-3xl leading-8 text-[#eee7d7]">
          A growing historical archive of baseballs signed by American presidents.
          Explore documented examples, discover the stories behind their signatures,
          and follow the original historical sources.
        </p>
      </section>

      <section className="mx-auto max-w-6xl px-6 py-12">
        <div className="mb-10 grid gap-5 md:grid-cols-3">
          {[
            ["01", "The President", "Explore each presidential signature in its historical setting."],
            ["02", "The Baseball", "Examine the documented artifact and its provenance."],
            ["03", "The Evidence", "Follow original catalogs, photographs, and authentication records."]
          ].map(([number, title, description]) => (
            <div key={number} className="border border-[#b8aa8e] bg-[#f8f3e8] p-6">
              <p className="font-serif text-3xl text-[#a4282d]">{number}</p>
              <h2 className="mt-3 font-serif text-xl font-bold">{title}</h2>
              <p className="mt-3 text-sm leading-7 text-[#59636b]">{description}</p>
            </div>
          ))}
        </div>

        <div className="mb-8 border-l-4 border-[#a4282d] bg-[#f8f3e8] p-5 text-sm leading-7">
          <strong>Curatorial note:</strong> These entries document historical references,
          not artifacts owned or independently authenticated by Presidential Pastime.
          Individual object photographs and authentication details will be added after
          verification and image-permission review.
        </div>

        <div className="mb-8 flex flex-wrap items-end justify-between gap-4">
          <div>
            <p className="text-xs font-bold uppercase tracking-[0.2em] text-[#a4282d]">
              The Presidential Archive
            </p>
            <h2 className="mt-2 font-serif text-3xl font-bold">Explore the Signatures</h2>
            <p className="mt-2 text-sm text-[#59636b]">
              {filtered.length} documented presidential entries
            </p>
          </div>
          <input
            aria-label="Search presidents"
            placeholder="Search a president..."
            value={search}
            onChange={event => setSearch(event.target.value)}
            className="w-full border border-[#b8aa8e] bg-white px-4 py-3 md:w-72"
          />
        </div>

        <div className="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          {filtered.map(artifact => (
            <article key={artifact.number} className="overflow-hidden border border-[#b8aa8e] bg-[#f8f3e8]">
              <div className="relative flex h-56 items-center justify-center bg-[#102c44]">
                <span className="absolute left-5 top-5 text-xs font-bold uppercase tracking-widest text-[#d7bb83]">
                  President No. {artifact.number}
                </span>
                <div className="flex h-32 w-32 items-center justify-center rounded-full border-4 border-[#b89a61] bg-[#eee7d7] shadow-xl">
                  <span className="text-6xl">⚾</span>
                </div>
                <span className="absolute bottom-4 text-xs uppercase tracking-widest text-[#d7bb83]">
                  Artifact photo pending
                </span>
              </div>
              <div className="p-6">
                <p className="text-xs font-bold uppercase tracking-widest text-[#a4282d]">
                  {artifact.years}
                </p>
                <h3 className="mt-2 font-serif text-2xl font-bold">{artifact.president}</h3>
                <p className="mt-4 text-sm leading-7 text-[#59636b]">{artifact.note}</p>
                <p className="mt-4 text-xs text-[#59636b]">Historical source: {artifact.source}</p>
                <a
                  href={artifact.sourceUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  className="mt-5 inline-block border-b-2 border-[#a4282d] pb-1 text-sm font-bold text-[#a4282d]"
                >
                  View historical source ↗
                </a>
              </div>
            </article>
          ))}
        </div>
        {filtered.length === 0 && <p>No presidents match your search.</p>}
      </section>

      <footer className="border-t-4 border-[#a4282d] bg-[#102c44] px-6 py-10 text-center text-sm text-[#eee7d7]">
        Presidential Pastime · Preserving the intersection of the presidency and America's pastime.
      </footer>
    </main>
  );
}
